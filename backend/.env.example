# eDNA Explorer Backend Configuration

# Application Metadata & Runtime Environment
APP_NAME=edna-explorer-api
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=False

# Server Network Binding
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api

# CORS Allowed Origins (comma-separated list for browser cross-origin requests)
# In production, specify the exact domain of the deployed frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection URL
# Default is persistent SQLite with Write-Ahead Logging (WAL)
# For enterprise production: postgresql://user:password@localhost:5432/edna_explorer
DATABASE_URL=sqlite:///./edna_explorer.db

# Validation Constraints & File Upload Limits
# 10 MB default limit (10 * 1024 * 1024 bytes)
MAX_FILE_SIZE_BYTES=10485760

# Amplicon Length Constraints (18S V4 expected range)
MIN_SEQUENCE_LENGTH=200
MAX_SEQUENCE_LENGTH=2000
