{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "edna-classification-result-v1",
  "title": "eDNA classification result, contract v1.0",
  "description": "Model-agnostic output of any classifier in this project. Consumers MUST ignore unknown fields (additive changes keep the same major version).",
  "type": "object",
  "required": ["contract_version", "run", "sequences"],
  "properties": {
    "contract_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "run": {
      "type": "object",
      "required": ["run_id", "created_utc", "model", "reference", "marker", "ranks", "threshold"],
      "properties": {
        "run_id": { "type": "string" },
        "created_utc": { "type": "string", "description": "ISO-8601 UTC timestamp" },
        "model": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "description": "e.g. modelA_reg_ens5, idtaxa" },
            "version": { "type": "string" },
            "code_commit": { "type": ["string", "null"], "description": "git commit hash of the code that produced the result" }
          }
        },
        "reference": {
          "type": "object",
          "required": ["name", "version"],
          "properties": {
            "name": { "type": "string", "description": "e.g. PR2" },
            "version": { "type": "string", "description": "e.g. 5.0.0" },
            "subset": { "type": ["string", "null"], "description": "how the reference was filtered, e.g. '18S V4, 99% clustered'" }
          }
        },
        "marker": {
          "type": "object",
          "required": ["gene", "region"],
          "properties": {
            "gene": { "type": "string", "description": "e.g. 18S rRNA" },
            "region": { "type": "string", "description": "e.g. V4" }
          }
        },
        "ranks": {
          "type": "array", "minItems": 1, "items": { "type": "string" },
          "description": "Ordered root->leaf rank names. Do NOT hardcode; other markers/models may use other rank lists."
        },
        "threshold": {
          "type": "object",
          "required": ["tau"],
          "properties": {
            "tau": { "type": "number", "minimum": 0, "maximum": 1 },
            "rule": { "type": "string" }
          }
        },
        "confidence_semantics": { "type": "string", "description": "What the confidence numbers mean for THIS model" }
      }
    },
    "sequences": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "assigned_depth", "lineage"],
        "properties": {
          "id": { "type": "string" },
          "length": { "type": ["integer", "null"] },
          "status": { "enum": ["assigned_full", "assigned_partial", "unassigned", "invalid_input"] },
          "assigned_depth": { "type": "integer", "minimum": 0 },
          "deepest_rank": { "type": ["string", "null"] },
          "deepest_taxon": { "type": ["string", "null"] },
          "lineage": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rank", "taxon", "confidence", "assigned"],
              "properties": {
                "rank": { "type": "string" },
                "taxon": { "type": ["string", "null"], "description": "model's best call at this rank, even if below tau; null if none" },
                "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
                "assigned": { "type": "boolean", "description": "true for the leading ranks with confidence >= tau" }
              }
            }
          },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "extras": {
            "type": "object",
            "description": "Optional model-specific fields. Reserved: novelty {score, method}, nearest_references [{reference_id, distance}]. None are produced by the current code."
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "n_sequences": { "type": "integer" },
        "n_by_status": { "type": "object" },
        "n_by_deepest_rank": { "type": "object" }
      }
    }
  }
}
